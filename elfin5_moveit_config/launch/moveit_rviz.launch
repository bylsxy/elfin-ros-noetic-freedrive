<launch>

  <arg name="debug" default="false" />
  <arg unless="$(arg debug)" name="launch_prefix" value="" />
  <arg     if="$(arg debug)" name="launch_prefix" value="gdb --ex run --args" />

  <arg name="config" default="false" />
  <arg name="config_file" default="$(find elfin5_moveit_config)/launch/moveit_low_load.rviz" />
  <arg name="use_egl" default="false" />
  <arg unless="$(arg config)" name="command_args" value="" />
  <arg     if="$(arg config)" name="command_args" value="-d $(arg config_file)" />

  <group unless="$(arg use_egl)">
    <node name="$(anon rviz)" launch-prefix="$(arg launch_prefix)" pkg="rviz" type="rviz" respawn="false"
          args="$(arg command_args)" output="screen">
      <rosparam command="load" file="$(find elfin5_moveit_config)/config/kinematics.yaml"/>
    </node>
  </group>

  <!-- Optional fallback for Jetson GLX driver crashes; never selected silently. -->
  <group if="$(arg use_egl)">
    <node name="$(anon rviz)" launch-prefix="$(arg launch_prefix)" pkg="rviz" type="rviz" respawn="false"
          args="$(arg command_args)" output="screen">
      <env name="QT_XCB_GL_INTEGRATION" value="xcb_egl" />
      <rosparam command="load" file="$(find elfin5_moveit_config)/config/kinematics.yaml"/>
    </node>
  </group>

</launch>
